#!/bin/sh
set -eu

INSTALL_DIR=${DJONEHUB_INSTALL_DIR:-/usr/local/libexec/djonehub}
COMMAND_PATH=${DJONEHUB_COMMAND_PATH:-/usr/local/bin/djonehub}
NOTIFIER_LABEL=com.yewenkai.djonehub-notifier
NOTIFIER_PROCESS=DJOneHubNotifier
NOTIFIER_APP="/Applications/DJOneHub 通知助手.app"

if [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER}" != "root" ]; then
  LOGIN_USER=${SUDO_USER}
else
  LOGIN_USER=$(id -un)
fi
LOGIN_UID=$(id -u "${LOGIN_USER}")
LOGIN_HOME=$(dscl . -read "/Users/${LOGIN_USER}" NFSHomeDirectory | awk '{print $2}')
NOTIFIER_PLIST="${LOGIN_HOME}/Library/LaunchAgents/${NOTIFIER_LABEL}.plist"

run_privileged() {
  if [ "${DJONEHUB_INSTALL_NO_SUDO:-0}" = "1" ]; then
    "$@"
  else
    sudo "$@"
  fi
}

run_as_login_user() {
  if [ "$(id -u)" -eq "${LOGIN_UID}" ]; then
    "$@"
  else
    /usr/bin/sudo -u "${LOGIN_USER}" "$@"
  fi
}

launchctl_as_login_user() {
  if [ "$(id -u)" -eq "${LOGIN_UID}" ]; then
    /bin/launchctl "$@"
  else
    /bin/launchctl asuser "${LOGIN_UID}" /usr/bin/sudo -u "${LOGIN_USER}" /bin/launchctl "$@"
  fi
}

if [ -x "${COMMAND_PATH}" ]; then
  run_as_login_user "${COMMAND_PATH}" stop >/dev/null 2>&1 || true
fi
launchctl_as_login_user bootout "gui/${LOGIN_UID}/${NOTIFIER_LABEL}" >/dev/null 2>&1 || true
pkill -u "${LOGIN_UID}" -TERM -x "${NOTIFIER_PROCESS}" >/dev/null 2>&1 || true

run_privileged rm -f -- "${COMMAND_PATH}"
run_privileged rm -rf -- "${INSTALL_DIR}" "${NOTIFIER_APP}"
rm -f -- "${NOTIFIER_PLIST}"

if [ "${1:-}" = "--purge" ]; then
  rm -rf -- \
    "${LOGIN_HOME}/Library/Application Support/DJOneHub" \
    "${LOGIN_HOME}/Library/Logs/DJOneHub"
  echo "DJOneHub 已卸载，本地运行数据和日志也已永久删除。"
else
  echo "DJOneHub 已卸载；本地运行数据和日志已保留，可使用 --purge 一并删除。"
fi
