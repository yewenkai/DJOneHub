#!/bin/sh
set -eu

SOURCE=$0
while [ -L "${SOURCE}" ]; do
  SOURCE_DIR=$(CDPATH= cd -P -- "$(dirname -- "${SOURCE}")" && pwd)
  SOURCE=$(readlink "${SOURCE}")
  case "${SOURCE}" in
    /*) ;;
    *) SOURCE="${SOURCE_DIR}/${SOURCE}" ;;
  esac
done
PACKAGE_DIR=$(CDPATH= cd -P -- "$(dirname -- "${SOURCE}")" && pwd)
INSTALL_DIR=${DJONEHUB_INSTALL_DIR:-/usr/local/libexec/djonehub}
COMMAND_PATH=${DJONEHUB_COMMAND_PATH:-/usr/local/bin/djonehub}
NOTIFIER_LABEL=com.yewenkai.djonehub-notifier

if [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER}" != "root" ]; then
  LOGIN_USER=${SUDO_USER}
else
  LOGIN_USER=$(id -un)
fi
LOGIN_UID=$(id -u "${LOGIN_USER}")
LOGIN_HOME=$(dscl . -read "/Users/${LOGIN_USER}" NFSHomeDirectory | awk '{print $2}')
NOTIFIER_DIR="${LOGIN_HOME}/Library/Application Support/DJOneHub/notifier"
LAUNCH_AGENTS_DIR="${LOGIN_HOME}/Library/LaunchAgents"
NOTIFIER_PLIST="${LAUNCH_AGENTS_DIR}/${NOTIFIER_LABEL}.plist"

run_privileged() {
  if [ "${DJONEHUB_INSTALL_NO_SUDO:-0}" = "1" ]; then
    "$@"
  else
    sudo "$@"
  fi
}

run_as_login_user() {
  if [ "$(id -u)" -eq "${LOGIN_UID}" ]; then
    "$@"
  else
    /usr/bin/sudo -u "${LOGIN_USER}" "$@"
  fi
}

launchctl_as_login_user() {
  if [ "$(id -u)" -eq "${LOGIN_UID}" ]; then
    /bin/launchctl "$@"
  else
    /bin/launchctl asuser "${LOGIN_UID}" /usr/bin/sudo -u "${LOGIN_USER}" /bin/launchctl "$@"
  fi
}

if [ "$(uname -m)" != "arm64" ]; then
  echo "当前安装包仅支持 Apple Silicon（M 系列芯片）。" >&2
  exit 1
fi
if [ ! -x "${PACKAGE_DIR}/djonehub" ] || [ ! -x "${PACKAGE_DIR}/bin/djonehub-macos" ] || \
   [ ! -x "${PACKAGE_DIR}/notifier/DJOneHubNotifier.app/Contents/MacOS/DJOneHubNotifier" ]; then
  echo "安装失败：发行包内容不完整，请重新解压整个 ZIP。" >&2
  exit 1
fi

if [ -x "${COMMAND_PATH}" ]; then
  "${COMMAND_PATH}" stop >/dev/null 2>&1 || true
fi

echo "DJOneHub 将安装到 ${INSTALL_DIR}"
echo "macOS 可能要求输入当前用户的管理员密码。"

run_privileged mkdir -p "${INSTALL_DIR}" "$(dirname -- "${COMMAND_PATH}")"
run_privileged ditto --norsrc --noextattr --noqtn --noacl "${PACKAGE_DIR}" "${INSTALL_DIR}"
run_privileged chmod 755 "${INSTALL_DIR}/djonehub" "${INSTALL_DIR}/bin/djonehub-macos" "${INSTALL_DIR}/lib/libusb-1.0.0.dylib"
run_privileged ln -sfn "${INSTALL_DIR}/djonehub" "${COMMAND_PATH}"

launchctl_as_login_user bootout "gui/${LOGIN_UID}/${NOTIFIER_LABEL}" >/dev/null 2>&1 || true
run_as_login_user mkdir -p "${NOTIFIER_DIR}" "${LAUNCH_AGENTS_DIR}"
run_as_login_user ditto --norsrc --noextattr --noqtn --noacl \
  "${PACKAGE_DIR}/notifier/DJOneHubNotifier.app" "${NOTIFIER_DIR}/DJOneHubNotifier.app"
run_as_login_user cp "${PACKAGE_DIR}/notifier/${NOTIFIER_LABEL}.plist" "${NOTIFIER_PLIST}"
run_as_login_user chmod 644 "${NOTIFIER_PLIST}"
launchctl_as_login_user bootstrap "gui/${LOGIN_UID}" "${NOTIFIER_PLIST}"

echo
echo "DJOneHub 安装完成。现在可以在任意目录执行："
echo "  djonehub start"
echo "原生来电和短信通知助手已为 ${LOGIN_USER} 启动。"
echo
echo "停止程序："
echo "  djonehub stop"
